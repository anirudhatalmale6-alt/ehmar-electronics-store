{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "White", "color": "#FFFFFF" },
				{ "slug": "surface", "name": "Surface", "color": "#F3F5F9" },
				{ "slug": "border", "name": "Border", "color": "#E2E6ED" },
				{ "slug": "muted", "name": "Muted text", "color": "#5A6478" },
				{ "slug": "contrast", "name": "Ink", "color": "#0B1527" },
				{ "slug": "navy", "name": "Navy", "color": "#0B1F3A" },
				{ "slug": "primary", "name": "Electric blue", "color": "#1659E6" },
				{ "slug": "accent", "name": "Orange", "color": "#FF7A1A" },
				{ "slug": "success", "name": "Green", "color": "#13915F" }
			]
		},
		"layout": { "contentSize": "760px", "wideSize": "1240px" },
		"spacing": {
			"defaultSpacingSizes": false,
			"spacingSizes": [
				{ "slug": "20", "name": "XS", "size": "0.5rem" },
				{ "slug": "30", "name": "S", "size": "1rem" },
				{ "slug": "40", "name": "M", "size": "clamp(1.25rem, 2vw, 1.75rem)" },
				{ "slug": "50", "name": "L", "size": "clamp(1.75rem, 3.5vw, 2.75rem)" },
				{ "slug": "60", "name": "XL", "size": "clamp(2.5rem, 6vw, 4.5rem)" }
			]
		},
		"typography": {
			"defaultFontSizes": false,
			"fluid": true,
			"fontSizes": [
				{ "slug": "small", "name": "Small", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Medium", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Large", "size": "1.25rem", "fluid": { "min": "1.125rem", "max": "1.25rem" } },
				{ "slug": "x-large", "name": "X Large", "size": "1.75rem", "fluid": { "min": "1.375rem", "max": "1.75rem" } },
				{ "slug": "xx-large", "name": "XX Large", "size": "3rem", "fluid": { "min": "2rem", "max": "3rem" } }
			],
			"fontFamilies": [
				{
					"name": "Manrope",
					"slug": "manrope",
					"fontFamily": "Manrope, system-ui, sans-serif",
					"fontFace": [
						{
							"src": [ "file:./assets/fonts/manrope/Manrope-VariableFont_wght.woff2" ],
							"fontWeight": "200 800",
							"fontStyle": "normal",
							"fontFamily": "Manrope"
						}
					]
				}
			]
		}
	},
	"styles": {
		"color": { "background": "var:preset|color|base", "text": "var:preset|color|contrast" },
		"typography": { "fontFamily": "var:preset|font-family|manrope", "fontSize": "var:preset|font-size|medium", "lineHeight": "1.6", "fontWeight": "500" },
		"spacing": { "blockGap": "1.25rem", "padding": { "left": "var:preset|spacing|40", "right": "var:preset|spacing|40" } },
		"elements": {
			"heading": { "typography": { "fontWeight": "800", "lineHeight": "1.15", "letterSpacing": "-0.02em" }, "color": { "text": "var:preset|color|contrast" } },
			"h1": { "typography": { "fontSize": "var:preset|font-size|xx-large" } },
			"h2": { "typography": { "fontSize": "var:preset|font-size|x-large" } },
			"h3": { "typography": { "fontSize": "var:preset|font-size|large" } },
			"link": { "color": { "text": "var:preset|color|primary" }, "typography": { "textDecoration": "none" }, ":hover": { "typography": { "textDecoration": "underline" } } },
			"button": {
				"color": { "background": "var:preset|color|primary", "text": "var:preset|color|base" },
				"border": { "radius": "10px" },
				"typography": { "fontWeight": "700", "fontSize": "var:preset|font-size|medium" },
				"spacing": { "padding": { "top": "0.8rem", "bottom": "0.8rem", "left": "1.4rem", "right": "1.4rem" } },
				":hover": { "color": { "background": "var:preset|color|navy" } }
			}
		},
		"blocks": {
			"core/post-title": { "typography": { "fontWeight": "700", "letterSpacing": "-0.01em" } },
			"woocommerce/product-price": { "typography": { "fontWeight": "800" }, "color": { "text": "var:preset|color|contrast" } }
		}
	},
	"templateParts": [
		{ "name": "header", "title": "Header", "area": "header" },
		{ "name": "footer", "title": "Footer", "area": "footer" }
	]
}
